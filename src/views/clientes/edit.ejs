<div class="cabecera-seccion">
    <h1>Editar cliente</h1>
    <a href="/clientes" class="btn btn-secundario">Volver</a>
</div>
<form action="/clientes/<%= cliente.id %>?_method=PUT" method="POST" class="formulario">
    <%- include('_form') %>
    <div class="formulario-botones">
        <button type="submit" class="btn btn-primario">Actualizar</button>
        <a href="/clientes" class="btn btn-secundario">Cancelar</a>
    </div>
</form>
