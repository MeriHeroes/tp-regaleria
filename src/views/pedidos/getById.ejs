<div class="cabecera-seccion">
    <h1>Pedido #<%= pedido.id %> — <%= pedido.cliente_nombre %></h1>
    <a href="/pedidos" class="btn btn-secundario">Volver a pedidos</a>
</div>

<form action="/pedidos/<%= pedido.id %>?_method=PUT" method="POST" class="formulario" style="margin-bottom: 2rem;">
    <h2>Datos del pedido</h2>
    <div class="fila-doble">
        <div class="campo">
            <label>Fecha</label>
            <input type="text" value="<%= pedido.fecha %>" disabled>
        </div>
        <div class="campo">
            <label for="estado">Estado</label>
            <select id="estado" name="estado">
                <% ['Pendiente', 'En preparación', 'Listo para entregar', 'Entregado'].forEach(est => { %>
                    <option value="<%= est %>" <%= pedido.estado === est ? 'selected' : '' %>><%= est %></option>
                <% }) %>
            </select>
        </div>
    </div>
    <div class="campo">
        <label for="dedicatoria">Tarjeta / Dedicatoria</label>
        <textarea id="dedicatoria" name="dedicatoria" rows="2"><%= pedido.dedicatoria %></textarea>
    </div>
    <button type="submit" class="btn btn-primario">Actualizar estado / dedicatoria</button>
</form>

<h2>Productos incluidos en el pedido</h2>

<form action="/pedidos/<%= pedido.id %>/items" method="POST" class="formulario" style="margin-bottom: 1.5rem;">
    <div class="fila-doble">
        <div class="campo">
            <label for="producto_id">Agregar producto</label>
            <select id="producto_id" name="producto_id" required>
                <option value="">-- Seleccionar regalo --</option>
                <% productos.forEach(p => { %>
                    <option value="<%= p.id %>"><%= p.nombre %> ($ <%= Number(p.precio).toFixed(2) %>)</option>
                <% }) %>
            </select>
        </div>
        <div class="campo">
            <label for="cantidad">Cantidad</label>
            <input type="number" id="cantidad" name="cantidad" value="1" min="1" required>
        </div>
    </div>
    <button type="submit" class="btn btn-primario">+ Agregar al pedido</button>
</form>

<% if (items.length === 0) { %>
    <div class="vacio"><p>Este pedido todavía no tiene productos cargados.</p></div>
<% } else { %>
    <div class="tabla-contenedor">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="num">Precio Unit.</th>
                    <th class="num">Cantidad</th>
                    <th class="num">Subtotal</th>
                    <th>Quitar</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach(item => { %>
                    <tr>
                        <td><%= item.producto_nombre %></td>
                        <td class="num">$ <%= Number(item.precio_unitario).toFixed(2) %></td>
                        <td class="num"><%= item.cantidad %></td>
                        <td class="num"><strong>$ <%= Number(item.subtotal).toFixed(2) %></strong></td>
                        <td>
                            <form action="/pedidos/<%= pedido.id %>/items/<%= item.id %>?_method=DELETE" method="POST">
                                <button type="submit" class="btn btn-chico btn-peligro">Quitar</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <h2 style="text-align: right; margin-top: 1rem;">Total del pedido: $ <%= Number(pedido.total).toFixed(2) %></h2>
<% } %>
