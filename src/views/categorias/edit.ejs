<div class="cabecera-seccion">
    <h1>Editar categoría</h1>
    <a href="/categorias" class="btn btn-secundario">Volver</a>
</div>

<form action="/categorias/<%= categoria.id %>?_method=PUT" method="POST" class="formulario">
    <%- include('_form') %>
    <div class="formulario-botones">
        <button type="submit" class="btn btn-primario">Actualizar</button>
        <a href="/categorias" class="btn btn-secundario">Cancelar</a>
    </div>
</form>