        <div class="tarjeta-etiqueta">Regalos en catálogo</div>
    </div>
    <div class="tarjeta">
        <div class="tarjeta-numero"><%= totalStock %></div>
        <div class="tarjeta-etiqueta">Unidades disponibles</div>
    </div>
    <div class="tarjeta">
        <div class="tarjeta-numero"><%= totalCategorias %></div>
        <div class="tarjeta-etiqueta">Categorías</div>
    </div>
    <div class="tarjeta">
        <div class="tarjeta-numero"><%= totalProveedores %></div>
        <div class="tarjeta-etiqueta">Proveedores</div>
    </div>
    <div class="tarjeta">
        <div class="tarjeta-numero"><%= totalClientes %></div>
        <div class="tarjeta-etiqueta">Clientes registrados</div>
    </div>
    <div class="tarjeta">
        <div class="tarjeta-numero"><%= totalPedidos %></div>
        <div class="tarjeta-etiqueta">Pedidos totales</div>
    </div>
