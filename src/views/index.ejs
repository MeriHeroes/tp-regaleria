<section class="hero-cherry">
    <div>
        <h1>Gestión de Regalería</h1>
        <p>Organizá tu catálogo de regalos, proveedores, clientes frecuentes y pedidos personalizados en un solo lugar.</p>
    </div>
    <div class="hero-botones">
        <a href="/pedidos/create" class="btn btn-hero-claro">+ Nuevo pedido</a>
        <a href="/productos/create" class="btn btn-hero-borde">+ Cargar regalo</a>
    </div>
</section>

